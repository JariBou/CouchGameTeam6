         Begin Object Name="NiagaraNodeFunctionCall_2" ExportPath="/Script/NiagaraEditor.NiagaraNodeFunctionCall'/Game/VRTemplate/VFX/RingEmitter.RingEmitter:NiagaraScriptSource_0.NiagaraGraph_0.NiagaraNodeFunctionCall_2'"
            FunctionScript="/Script/Niagara.NiagaraScript'/Niagara/Modules/Spawn/Initialization/InitializeRibbon.InitializeRibbon'"
            SelectedScriptVersion=E6EE70DA4B3E785C8D207CB2A9C32616
            CachedChangeId=6B8DA35D4E91DA7CFA5E969D28620BD9
            FunctionDisplayName="InitializeRibbon"
            StackMessages(0)=(MessageText=NSLOCTEXT("", "D9D26DF7438A71D6BD48FFA282CABF97", "\r\nOn the ribbon renderer, ribbons can be rendered with more shapes than just flat planes. Users can choose Tube, or an array of intersecting ribbon planes. Camera facing options still work with any of the modes, and a custom shape can even be provided.\r\n\r\nIn this example we lay all the particles out in a ring in the order they were born during the Spawn Burst (their Execution Index). We then choose the tube shape mode to create a 3d torus out of the ribbon."),bAllowDismissal=False,Guid=63DEFA3C49489945D5AB2985875E9213)
            BoundPinNames=((898E46224A286A40DCDAD78E23E0B3AD, "RibbonID.Ribbon ID Mode"),(74E7682A46263954764EB2BE691B7FC7, "Ribbon ID"),(12B9B0F94118510C56265382E9CA2D52, "Position Offset"),(DD6E839A4B8C2918A87A819858931094, "RibbonShapes.Ribbon Facing Mode"),(0CC534214BDA3C8DACB3369B47E35E8F, "InitializeRibbon.Color"))
            ChangeId=D372402745DBB624FB1D22A114E76283
            NodePosX=-2800
