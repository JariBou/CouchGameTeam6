      Begin Object Name="StackEditorData" ExportPath="/Script/NiagaraEditor.NiagaraStackEditorData'/Game/VRTemplate/VFX/RingEmitter.RingEmitter:NiagaraEmitterEditorData_0.StackEditorData'"
         StackEntryKeyToExpandedMap=(("Render", True),("Renderer-NiagaraRibbonRendererProperties_0", True),("8C991337-4143-FF00-4948-70AEF6E34365", True),("27514457-48CA-1726-F3F0-FE851F76130A", True))
         StackNotes=(("8C991337-4143-FF00-4948-70AEF6E34365", (Message=NSLOCTEXT("", "D9D26DF7438A71D6BD48FFA282CABF97", "\r\nOn the ribbon renderer, ribbons can be rendered with more shapes than just flat planes. Users can choose Tube, or an array of intersecting ribbon planes. Camera facing options still work with any of the modes, and a custom shape can even be provided.\r\n\r\nIn this example we lay all the particles out in a ring in the order they were born during the Spawn Burst (their Execution Index). We then choose the tube shape mode to create a 3d torus out of the ribbon."))))
         DismissedStackIssueIds(0)="9138fd2d9887327639e96b4a696342be"
      End Object
      StackEditorData="StackEditorData"
      PlaybackRangeMin=-0.170833
      PlaybackRangeMax=5.004167
      SummaryViewRoot="SummaryViewRoot"
   End Object
